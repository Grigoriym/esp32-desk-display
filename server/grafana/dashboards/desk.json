    {
      "id": 4,
      "type": "stat",
      "title": "Pressure 3h",
      "description": "Pressure change over the last 3 hours. Falling more than 3 hPa (orange/red): weather getting worse, rain or wind coming. Rising more than 3 hPa (blue): clearing up. Within ±1: no change.",
      "gridPos": {
        "x": 9,
        "y": 0,
        "w": 3,
        "h": 4
      },
      "datasource": {
        "type": "influxdb",
        "uid": "influxdb"
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "influxdb",
            "uid": "influxdb"
          },
          "query": "data = from(bucket: \"desk\")\n  |> range(start: -3h)\n  |> filter(fn: (r) => r._measurement == \"indoor\" and r._field == \"pressure_hpa\")\nunion(tables: [data |> first(), data |> last()])\n  |> sort(columns: [\"_time\"])\n  |> difference()"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "pressurehpa",
          "decimals": 1,
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "red",
                "value": null
              },
              {
                "color": "orange",
                "value": -6
              },
              {
                "color": "yellow",
                "value": -3
              },
              {
                "color": "green",
                "value": -1
              },
              {
                "color": "text",
                "value": 1
              },
              {
                "color": "blue",
                "value": 3
              }
            ]
          },
          "color": {
            "mode": "thresholds"
          }
        },
        "overrides": [
          {
            "matcher": {
              "id": "byFrameRefID",
              "options": "A"
            },
            "properties": [
              {
                "id": "displayName",
                "value": "Change"
              }
            ]
          }
        ]
      },
