    {
      "id": 3,
      "type": "stat",
      "title": "Pressure",
      "description": "Air pressure in hPa, measured in the room (same as outside). Reads about 4 hPa below weather reports: those are converted to sea level, Berlin is ~35 m up. Rough guide (weather-report values): under 1000 low, unsettled, rain and wind likely; 1010-1020 normal; above 1025 high, settled, dry. The trend matters more than the value: see Pressure 3h.",
      "gridPos": {
        "x": 6,
        "y": 0,
        "w": 3,
        "h": 4
      },
      "datasource": {
        "type": "influxdb",
