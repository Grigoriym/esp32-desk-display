#pragma once

// Copy this file to bvg_secrets.h (gitignored) and fill in your stop.
// Stop IDs: <VBB_BASE_URL>/location.name?accessId=<id>&input=<name>&format=json ("extId")
#define BVG_STOP_ID      "900000000000" // the stop you leave from
#define BVG_DIRECTION_ID "900000000000" // the NEXT stop in your direction of travel
#define BVG_PRODUCTS     "2" // VBB bitmask: 1 S-Bahn, 2 U-Bahn, 4 tram, 8 bus, 16 ferry, 32 ICE/IC, 64 regional
#define BVG_WALK_MIN_MINUTES     6  // trains sooner than this can't be caught: hidden
#define BVG_WALK_COMFORT_MINUTES 11 // "GO NOW" at this many minutes left, "HURRY" below, "LEAVE IN N" above

// From VBB (api@vbb.de): access ID and the test or production system URL.
#define VBB_ACCESS_ID "your-access-id"
#define VBB_BASE_URL  "https://vbb.demo.hafas.cloud/api/fahrinfo/latest"
